# Copy to `.env` and fill in real values before `docker compose up`.

# ─── Postgres ─────────────────────────────────────────────────────────────
POSTGRES_USER=dropln
POSTGRES_DB=dropln
# REQUIRED — generate with e.g. `openssl rand -base64 24`
POSTGRES_PASSWORD=

# ─── Dropln ───────────────────────────────────────────────────────────────
# Bind only to loopback by default — front it with nginx/Caddy.
DROPLN_PORT=8080
DROPLN_ADDR=:8080

# 32 MiB POST body limit (frontend warns user via /api/v1/info).
DROPLN_MAX_PASTE_BYTES=33554432

# Rate limit on POST /api/v1/paste and POST /api/v1/paste/{id}/comment.
DROPLN_RATE_LIMIT_PER_MIN=10
DROPLN_RATE_LIMIT_BURST=5

# Set to `true` ONLY if a trusted reverse proxy strips spoofed headers.
# When true, the rate limiter and request logs use X-Forwarded-For / X-Real-IP.
DROPLN_TRUST_PROXY=false

# Set to `true` once you're serving over HTTPS (e.g. via Caddy with auto-TLS).
# Sends `Strict-Transport-Security: max-age=63072000; includeSubDomains`.
DROPLN_HSTS=false
